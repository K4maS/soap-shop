# =============================================================
# MYLO MASTER — Environment Variables Template
# =============================================================
# SECURITY: Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# ─── Application ────────────────────────────────────────────
NODE_ENV=production
APP_NAME=mylo-master
APP_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
API_PORT=3001
AUTH_PORT=3002
ADMIN_PORT=3003

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mylo_master
POSTGRES_USER=mylo_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS
POSTGRES_SSL=true

# Prisma connection string
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public&sslmode=prefer&connection_limit=10&pool_timeout=20

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_TLS=false

# ─── JWT & Crypto ────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=QbcpHz1vm3MbMAJItl477qLNUoxE+02wGDLCZAty0Zw=
ENCRYPTION_IV_LENGTH=16

# CSRF
CSRF_SECRET=CHANGE_ME_CSRF_SECRET_MIN_32_CHARS

# ─── OTP Settings ────────────────────────────────────────────
OTP_LIFETIME_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_BLOCK_DURATION_MINUTES=15
OTP_RATE_PER_NUMBER_SECONDS=60
OTP_RATE_PER_IP_HOUR=5

# ─── SMS Gateway ─────────────────────────────────────────────
SMS_PROVIDER=mock
# Options: mock | smsaero | smsc | twilio
SMSAERO_EMAIL=your@email.com
SMSAERO_API_KEY=CHANGE_ME
SMSC_LOGIN=CHANGE_ME
SMSC_PASSWORD=CHANGE_ME
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM_NUMBER=+1234567890

# ─── File Uploads ────────────────────────────────────────────
UPLOAD_PROVIDER=local
# Options: local | s3
UPLOAD_MAX_SIZE_MB=2
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
LOCAL_UPLOAD_PATH=/app/uploads

# AWS S3 (if UPLOAD_PROVIDER=s3)
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=eu-central-1
AWS_S3_BUCKET=mylo-master-uploads
AWS_CLOUDFRONT_URL=

# ─── Email ───────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM="Mylo Master <noreply@yourdomain.com>"

# ─── Telegram Notifications ──────────────────────────────────
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_ADMIN_CHAT_ID=CHANGE_ME

# ─── Payment Gateways ────────────────────────────────────────
YOOKASSA_SHOP_ID=CHANGE_ME
YOOKASSA_SECRET_KEY=CHANGE_ME
YOOKASSA_RETURN_URL=https://yourdomain.com/payment/return

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
CORS_CREDENTIALS=true

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
AUDIT_LOG_RETENTION_DAYS=90

# ─── CDEK Delivery ───────────────────────────────────────────
CDEK_CLIENT_ID=CHANGE_ME
CDEK_CLIENT_SECRET=CHANGE_ME
CDEK_API_URL=https://api.edu.cdek.ru/v2

# ─── Security ────────────────────────────────────────────────
BCRYPT_ROUNDS=12
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS
COOKIE_DOMAIN=.yourdomain.com

# ─── Docker ──────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=mylo-master
