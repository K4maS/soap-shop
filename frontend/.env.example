# =============================================================================
# Mylo Master Frontend — Environment Variables
# Copy to .env.local for local development.
# NEVER commit .env.local to version control.
# =============================================================================

# API base URL — used by Vite dev proxy and the axios client.
# In production, set this to your real API domain.
# In development with Vite proxy, this can be /api (proxied to backend).
VITE_API_BASE_URL=http://localhost:3001/api

# App name (optional — used in meta tags)
VITE_APP_NAME=MyloMaster

# Enable/disable React Query DevTools in non-dev builds (optional)
# VITE_ENABLE_DEVTOOLS=true
