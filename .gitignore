# =============================================================
# .gitignore — NEVER commit secrets or node_modules
# =============================================================

# Environment — КРИТИЧЕСКИ ВАЖНО
.env
.env.local
.env.*.local
*.env
!.env.example

# SSL certificates
nginx/ssl/
*.pem
*.key
*.crt
*.p12

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
.next/
out/

# TypeScript
*.js.map
*.d.ts.map

# Prisma
backend/api/prisma/generated/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pino-*.log

# Runtime
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
*.lcov
.nyc_output/

# Docker volumes (local)
postgres_data/
redis_data/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Uploads (local development)
uploads/
!uploads/.gitkeep

# Vitest
.vitest-cache/

# Vite
frontend/.vite/

# Temporary
*.tmp
*.temp
tmp/
temp/
